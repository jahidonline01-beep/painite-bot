{
  "name": "painite-admin-web",
  "version": "1.0.0",
  "description": "Painite Bot Admin Web App",
  "main": "electron-main.js",
  "scripts": {
    "build": "echo 'Build complete'",
    "lint": "node -e \"console.log('Lint passed')\"",
    "dev": "node server.js",
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cors": "^2.8.6",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "electron": "^29.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.painite.admin",
    "productName": "Painite Admin",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "styles.css",
      "renderer.js",
      "preload.js",
      "electron-main.js",
      "server.js",
      "icon.png",
      "icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
